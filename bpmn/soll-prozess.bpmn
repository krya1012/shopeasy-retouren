    <bpmn:textAnnotation id="Ann_1"><bpmn:text>Alle Statuswechsel werden als Events publiziert → Echtzeit-Dashboard und Process Mining ersetzen das manuelle monatliche Excel-Reporting.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_2"><bpmn:text>Tracking-Events und erwartetes Retourenaufkommen je Tag fließen in die Schichtplanung des Lagers (W15). Kosten der Sendungsverfolgung gegen Nutzen abwägen.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_3"><bpmn:text>Statusnachricht an Kund:in bei jedem Statuswechsel: angelegt, Label, eingegangen, Entscheidung, erstattet (W13).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="Ann_1" targetRef="end" />
    <bpmn:association id="Assoc_2" sourceRef="Ann_2" targetRef="t_notify" />
    <bpmn:association id="Assoc_3" sourceRef="Ann_3" targetRef="t_create" />
  </bpmn:process>
