<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Soll" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Soll">
    <bpmn:participant id="Participant_Soll" name="ShopEasy GmbH – Retourenabwicklung (Soll-Prozess)" processRef="Process_Soll" />
    <bpmn:participant id="Ext_Markt" name="Marktplatz (Amazon, Zalando)" />
    <bpmn:participant id="Ext_Kunde" name="Kund:in" />
    <bpmn:messageFlow id="m1" sourceRef="Ext_Markt" targetRef="s_mkt" />
    <bpmn:messageFlow id="m2" sourceRef="Ext_Kunde" targetRef="s_web" />
    <bpmn:messageFlow id="m3" sourceRef="Ext_Kunde" targetRef="s_mail" />
    <bpmn:messageFlow id="m4" sourceRef="t_deny" targetRef="Ext_Kunde" />
    <bpmn:messageFlow id="m5" sourceRef="t_deny2" targetRef="Ext_Kunde" />
    <bpmn:messageFlow id="m6" sourceRef="t_notify" targetRef="Ext_Kunde" />
    <bpmn:messageFlow id="m7" sourceRef="Ext_Kunde" targetRef="ev_arrive" />
    <bpmn:messageFlow id="m8" sourceRef="t_expired" targetRef="Ext_Kunde" />
    <bpmn:messageFlow id="m9" sourceRef="t_end_notify" targetRef="Ext_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Soll" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_WF" name="Retouren-Workflow (automatisiert)">
        <bpmn:flowNodeRef>s_mkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_parse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_evt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_pj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_end_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lager" name="Lager">
        <bpmn:flowNodeRef>t_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SB" name="Sachbearbeitung / Kundenservice">
        <bpmn:flowNodeRef>t_man1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deny2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_deny2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_label_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_man2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund_man</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_mkt" name="Marktplatz-Retoure eingegangen (REST)">
      <bpmn:documentation>Umsetzung: System/Service (Sprint 2: Mock-REST-API Amazon/Zalando).</bpmn:documentation>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="s_web" name="Retoure im Webshop angemeldet">
      <bpmn:documentation>Umsetzung: System/Service (Webshop sendet Retourenmeldung per REST an Retouren-Plattform).</bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="s_mail" name="Retoure per E-Mail angemeldet">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_parse" name="E-Mail auslesen und strukturieren&#10;«KI»">
      <bpmn:documentation>Umsetzung: KI (LLM-Extraktion von Bestellnummer, Artikel, Grund aus Freitext), Sprint 5.</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_create" name="Retourenfall zentral anlegen&#10;«System»">
      <bpmn:documentation>Umsetzung: System/Service. Gemeinsame Datenbasis, Fall-ID für alle Kanäle.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_case"><bpmn:targetRef>DS_case</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_ai" name="Retourengrund klassifizieren &amp; Betrugsscore berechnen&#10;«KI-Agent»">
      <bpmn:documentation>Umsetzung: KI-Agent (n8n), Sprint 5. Klassifikation des Retourengrunds aus Freitext, Erkennung auffälliger Muster (Wardrobing).</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="t_rule" name="Anmeldung prüfen (Frist, Artikel, Kundenhistorie)&#10;«Regel/DMN»">
      <bpmn:documentation>Umsetzung: Regeln (DMN). Entscheidung zulässig / Verdacht / unzulässig.</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw1" name="Prüfergebnis?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_deny" name="Ablehnung mitteilen&#10;«System»">
      <bpmn:documentation>Umsetzung: System (Nachricht über Broker, E-Mail an Kund:in).</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_deny" name="Retoure abgelehnt">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_join">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_label" name="Retourenlabel erzeugen&#10;«System»">
      <bpmn:documentation>Umsetzung: System/Service (Versanddienstleister-API).</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="b_label" name="Versand-API nicht erreichbar" attachedToRef="t_label">
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="t_notify" name="Label &amp; Status „genehmigt“ senden&#10;«Messaging»">
      <bpmn:documentation>Umsetzung: Messaging (Sprint 2: Status-Update über Message Broker).</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="gw_evt">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ev_arrive" name="Paket im Lager eingetroffen">
      <bpmn:documentation>Korrelation über Retouren-ID/Tracking.</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev_timeout" name="21 Tage ohne Wareneingang">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P21D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_expired" name="Retoure als nicht eingegangen schließen&#10;«System»">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_expired" name="Fall geschlossen (Frist abgelaufen)">
      <bpmn:incoming>f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="t_decide" name="Annahme/Ablehnung entscheiden&#10;«Regel/DMN»">
      <bpmn:documentation>Umsetzung: Regeln (DMN) auf Zustand, Warenwert, Betrugsscore.</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw2" name="Ergebnis?">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_acc">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_par">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="t_stock" name="Bestand im ERP buchen / korrigieren&#10;«RPA»">
      <bpmn:documentation>Umsetzung: RPA (UiPath-Bot im ERP-Frontend), Sprint 5.</bpmn:documentation>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_erp"><bpmn:targetRef>DS_erp</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_refund" name="Rückerstattung / Gutschein auslösen&#10;«System»">
      <bpmn:documentation>Umsetzung: System/Service (Zahlungsdienstleister-API, CRM).</bpmn:documentation>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="b_refund" name="Zahlung fehlgeschlagen" attachedToRef="t_refund">
      <bpmn:outgoing>f39</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gw_rm">
      <bpmn:documentation>Führt Rückerstattung und manuelle Klärung zusammen; so erreicht nur ein Token den parallelen Join.</bpmn:documentation>
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_pj">
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:incoming>f41</bpmn:incoming>
      <bpmn:outgoing>f42</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="t_end_notify" name="Kund:in über Ergebnis informieren&#10;«Messaging»">
      <bpmn:documentation>Umsetzung: Messaging. Status-Events speisen auch Dashboard / Process Mining (ersetzt Excel-Reporting).</bpmn:documentation>
      <bpmn:incoming>f42</bpmn:incoming>
      <bpmn:incoming>f43</bpmn:incoming>
      <bpmn:outgoing>f44</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end" name="Retoure abgeschlossen">
      <bpmn:incoming>f44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_gr" name="Zustand prüfen &amp; per Erfassungs-Client buchen&#10;«Mensch + Service»">
      <bpmn:documentation>Umsetzung: Mensch am Scanner, Daten über gRPC-Service (Sprint 2) mit definierter Zustandsskala.</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_wms"><bpmn:targetRef>DS_wms</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t_reject" name="Weiterverwendung festlegen (Rückversand / Spende / Entsorgung)&#10;«Mensch»">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_man1" name="Verdacht manuell prüfen&#10;«Mensch»">
      <bpmn:documentation>Umsetzung: Mensch. Entscheidung wird begründet dokumentiert.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_m1" name="Verdacht bestätigt?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_deny2" name="Ablehnung mitteilen&#10;«System»">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_deny2" name="Retoure abgelehnt">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_label_man" name="Label manuell erstellen&#10;«Mensch»">
      <bpmn:documentation>Fehlerbehandlung: Fallback bei Ausfall der Versand-API.</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_man2" name="Grenzfall prüfen &amp; Entscheidung dokumentieren&#10;«Mensch»">
      <bpmn:documentation>Umsetzung: Mensch, KI-Empfehlung als Entscheidungshilfe. Ersetzt Eskalation per E-Mail.</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_m2" name="Angenommen?">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_refund_man" name="Rückerstattung manuell klären&#10;«Mensch»">
      <bpmn:documentation>Fehlerbehandlung: Fallback bei fehlgeschlagener Zahlung.</bpmn:documentation>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DS_case" name="Retouren-Datenbank" />
    <bpmn:dataStoreReference id="DS_wms" name="WMS" />
    <bpmn:dataStoreReference id="DS_erp" name="ERP-System" />
    <bpmn:sequenceFlow id="f1" sourceRef="s_web" targetRef="t_create" />
    <bpmn:sequenceFlow id="f2" sourceRef="s_mkt" targetRef="t_create" />
    <bpmn:sequenceFlow id="f3" sourceRef="s_mail" targetRef="t_parse" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_parse" targetRef="t_create" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_create" targetRef="t_ai" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_ai" targetRef="t_rule" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_rule" targetRef="gw1" />
    <bpmn:sequenceFlow id="f8" name="zulässig" sourceRef="gw1" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f9" name="unzulässig" sourceRef="gw1" targetRef="t_deny" />
    <bpmn:sequenceFlow id="f10" name="Verdacht" sourceRef="gw1" targetRef="t_man1" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_deny" targetRef="end_deny" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_man1" targetRef="gw_m1" />
    <bpmn:sequenceFlow id="f13" name="nein" sourceRef="gw_m1" targetRef="gw_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdachtBestaetigt = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" name="ja" sourceRef="gw_m1" targetRef="t_deny2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdachtBestaetigt = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f15" sourceRef="t_deny2" targetRef="end_deny2" />
    <bpmn:sequenceFlow id="f16" sourceRef="gw_join" targetRef="t_label" />
    <bpmn:sequenceFlow id="f17" sourceRef="b_label" targetRef="t_label_man" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_label_man" targetRef="t_notify" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_label" targetRef="t_notify" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_notify" targetRef="gw_evt" />
    <bpmn:sequenceFlow id="f21" sourceRef="gw_evt" targetRef="ev_arrive" />
    <bpmn:sequenceFlow id="f22" sourceRef="gw_evt" targetRef="ev_timeout" />
    <bpmn:sequenceFlow id="f23" sourceRef="ev_timeout" targetRef="t_expired" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_expired" targetRef="end_expired" />
    <bpmn:sequenceFlow id="f25" sourceRef="ev_arrive" targetRef="t_gr" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_gr" targetRef="t_decide" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_decide" targetRef="gw2" />
    <bpmn:sequenceFlow id="f28" name="Annahme" sourceRef="gw2" targetRef="gw_acc" />
    <bpmn:sequenceFlow id="f29" name="Ablehnung" sourceRef="gw2" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f30" name="Grenzfall" sourceRef="gw2" targetRef="t_man2" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_man2" targetRef="gw_m2" />
    <bpmn:sequenceFlow id="f32" name="ja" sourceRef="gw_m2" targetRef="gw_acc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=angenommen = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f33" name="nein" sourceRef="gw_m2" targetRef="t_reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=angenommen = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f34" sourceRef="gw_acc" targetRef="gw_par" />
    <bpmn:sequenceFlow id="f35" sourceRef="gw_par" targetRef="t_stock" />
    <bpmn:sequenceFlow id="f36" sourceRef="gw_par" targetRef="t_refund" />
    <bpmn:sequenceFlow id="f37" sourceRef="t_stock" targetRef="gw_pj" />
    <bpmn:sequenceFlow id="f38" sourceRef="t_refund" targetRef="gw_rm" />
    <bpmn:sequenceFlow id="f39" sourceRef="b_refund" targetRef="t_refund_man" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_refund_man" targetRef="gw_rm" />
    <bpmn:sequenceFlow id="f41" sourceRef="gw_rm" targetRef="gw_pj" />
    <bpmn:sequenceFlow id="f42" sourceRef="gw_pj" targetRef="t_end_notify" />
