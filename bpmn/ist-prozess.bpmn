<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Ist" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Ist">
    <bpmn:participant id="Participant_Ist" name="ShopEasy GmbH – Retourenabwicklung (Ist-Prozess)" processRef="Process_Ist" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Ist" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Kunde" name="Kund:in">
        <bpmn:flowNodeRef>s_web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_mkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ship</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service" name="Kundenservice / Sachbearbeitung">
        <bpmn:flowNodeRef>t_mkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_erp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lager" name="Lager (WMS)">
        <bpmn:flowNodeRef>ev_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buch" name="Buchhaltung">
        <bpmn:flowNodeRef>gw_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_voucher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ref_m</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_web" name="Retoure im Webshop-Formular angemeldet">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="s_mkt" name="Retoure im Marktplatz-Tool angemeldet (Amazon/Zalando)">
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="s_mail" name="Retoure formlos per E-Mail angemeldet">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:manualTask id="t_mkt" name="Marktplatz-Portal sichten, Daten abtippen">
      <bpmn:documentation>Eigene API je Marktplatz, keine Anbindung an das ERP (Medienbruch).</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_DS_mkt"><bpmn:sourceRef>DS_mkt</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_mail" name="E-Mail lesen, Daten nachfragen, abtippen">
      <bpmn:documentation>Unstrukturierte Anmeldung; fehlende Angaben werden per E-Mail nachgefragt.</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_erp" name="Anmeldung im ERP manuell erfassen &amp; prüfen">
      <bpmn:documentation>Mehrfache manuelle Datenpflege; Prüfung nach Erfahrung der Sachbearbeiter:in.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:dataInputAssociation id="Assoc_DS_web"><bpmn:sourceRef>DS_web</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Assoc_DS_erp1"><bpmn:targetRef>DS_erp1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_label" name="Retourenlabel manuell im Versandtool erstellen">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_vers"><bpmn:targetRef>DS_vers</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_send" name="Label per E-Mail an Kund:in senden">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_mail1"><bpmn:targetRef>DS_mail1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:task id="t_ship" name="Ware zurücksenden (kein Status-Tracking)">
      <bpmn:documentation>Weder Kund:in noch ShopEasy sehen den Status der Sendung.</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ev_wait" name="Paket trifft im Lager ein">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="t_gr" name="Wareneingang &amp; Zustandsprüfung im WMS erfassen (oft verzögert)">
      <bpmn:documentation>Zustand: neuwertig / beschädigt / getragen. Subjektiv, Erfassung zeitversetzt.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_wms"><bpmn:targetRef>DS_wms</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_dec" name="Annahme/Ablehnung entscheiden">
      <bpmn:documentation>Entscheidung nicht dokumentiert und nicht regelbasiert.</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw1" name="Ergebnis?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_esc" name="Grenzfall per E-Mail eskalieren &amp; dokumentieren">
      <bpmn:documentation>Dokumentation nur im E-Mail-Postfach.</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_mail2"><bpmn:targetRef>DS_mail2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_stock" name="Bestandsbuchung im ERP">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_erp2"><bpmn:targetRef>DS_erp2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_reject" name="Rückversand / Entsorgung / Spende veranlassen">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_ref" name="Erstattungsart?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_pay" name="Rückerstattung manuell über Zahlungsdienstleister">
      <bpmn:documentation>Manuelle Buchung; größter Anteil an der Durchlaufzeit von 8–12 Tagen.</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_zdl"><bpmn:targetRef>DS_zdl</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_voucher" name="Gutschein manuell im CRM eintragen">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_crm"><bpmn:targetRef>DS_crm</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_ref_m">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_m">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_comm" name="Kund:in per E-Mail informieren (verzögert)">
      <bpmn:documentation>Häufige Nachfragen der Kund:innen.</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_mail3"><bpmn:targetRef>DS_mail3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="t_report" name="Monatliches Reporting in Excel erstellen">
      <bpmn:documentation>Retourenquote, Bearbeitungsdauer, Gründe – manuell zusammengestellt.</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_xls"><bpmn:targetRef>DS_xls</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:endEvent id="end" name="Retoure abgeschlossen">
      <bpmn:incoming>f26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_web" name="Webshop-Frontend" />
    <bpmn:dataStoreReference id="DS_mkt" name="Marktplatz-Portale" />
    <bpmn:dataStoreReference id="DS_erp1" name="ERP-System" />
    <bpmn:dataStoreReference id="DS_vers" name="Versandtool" />
    <bpmn:dataStoreReference id="DS_mail1" name="E-Mail-Postfach" />
    <bpmn:dataStoreReference id="DS_wms" name="WMS" />
    <bpmn:dataStoreReference id="DS_mail2" name="E-Mail-Postfach" />
    <bpmn:dataStoreReference id="DS_erp2" name="ERP-System" />
    <bpmn:dataStoreReference id="DS_zdl" name="Zahlungsdienstleister" />
    <bpmn:dataStoreReference id="DS_crm" name="CRM" />
    <bpmn:dataStoreReference id="DS_mail3" name="E-Mail-Postfach" />
    <bpmn:dataStoreReference id="DS_xls" name="Excel-Listen" />
    <bpmn:sequenceFlow id="f1" sourceRef="s_web" targetRef="t_erp" />
    <bpmn:sequenceFlow id="f2" sourceRef="s_mkt" targetRef="t_mkt" />
    <bpmn:sequenceFlow id="f3" sourceRef="s_mail" targetRef="t_mail" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_mkt" targetRef="t_erp" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_mail" targetRef="t_erp" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_erp" targetRef="t_label" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_label" targetRef="t_send" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_send" targetRef="t_ship" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_ship" targetRef="ev_wait" />
    <bpmn:sequenceFlow id="f10" sourceRef="ev_wait" targetRef="t_gr" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_gr" targetRef="t_dec" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_dec" targetRef="gw1" />
    <bpmn:sequenceFlow id="f13" name="Annahme" sourceRef="gw1" targetRef="t_stock" />
    <bpmn:sequenceFlow id="f14" name="Ablehnung" sourceRef="gw1" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f15" name="Grenzfall" sourceRef="gw1" targetRef="t_esc" />
    <bpmn:sequenceFlow id="f16" name="erneut entscheiden" sourceRef="t_esc" targetRef="t_dec" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_stock" targetRef="gw_ref" />
    <bpmn:sequenceFlow id="f18" name="Geld zurück" sourceRef="gw_ref" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f19" name="Gutschein" sourceRef="gw_ref" targetRef="t_voucher" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_pay" targetRef="gw_ref_m" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_voucher" targetRef="gw_ref_m" />
    <bpmn:sequenceFlow id="f22" sourceRef="gw_ref_m" targetRef="gw_m" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_reject" targetRef="gw_m" />
    <bpmn:sequenceFlow id="f24" sourceRef="gw_m" targetRef="t_comm" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_comm" targetRef="t_report" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_report" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Ist">
    <bpmndi:BPMNPlane id="Plane_Ist" bpmnElement="Collab_Ist">
      <bpmndi:BPMNShape id="Participant_Ist_di" bpmnElement="Participant_Ist" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2900" height="1100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kunde_di" bpmnElement="Lane_Kunde" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="2870" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true">
        <dc:Bounds x="30" y="240" width="2870" height="260" />
      </bpmndi:BPMNShape>
