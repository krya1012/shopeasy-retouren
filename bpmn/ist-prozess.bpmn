      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_mail1_di" bpmnElement="DS_mail1">
        <dc:Bounds x="825" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="800" y="486" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_wms_di" bpmnElement="DS_wms">
        <dc:Bounds x="1275" y="640" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1250" y="691" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_mail2_di" bpmnElement="DS_mail2">
        <dc:Bounds x="1865" y="265" width="50" height="50" />
