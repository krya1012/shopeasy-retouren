<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Ist" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Ist">
    <bpmn:participant id="Participant_Ist" name="ShopEasy GmbH – Retourenabwicklung (Ist-Prozess)" processRef="Process_Ist" />
    <bpmn:participant id="Ext_Markt" name="Marktplatz (Amazon, Zalando)" />
    <bpmn:participant id="Ext_Kunde" name="Kund:in" />
    <bpmn:messageFlow id="m1" sourceRef="Ext_Markt" targetRef="s_mkt" />
    <bpmn:messageFlow id="m2" sourceRef="Ext_Kunde" targetRef="s_web" />
    <bpmn:messageFlow id="m3" sourceRef="Ext_Kunde" targetRef="s_mail" />
    <bpmn:messageFlow id="m4" sourceRef="t_rej" targetRef="Ext_Kunde" />
    <bpmn:messageFlow id="m5" sourceRef="t_send" targetRef="Ext_Kunde" />
    <bpmn:messageFlow id="m6" sourceRef="Ext_Kunde" targetRef="ev_wait" />
    <bpmn:messageFlow id="m7" sourceRef="t_comm" targetRef="Ext_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Ist" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Service" name="Kundenservice / Sachbearbeitung">
        <bpmn:flowNodeRef>s_mkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_erp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lager" name="Lager (WMS)">
        <bpmn:flowNodeRef>ev_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buch" name="Buchhaltung">
        <bpmn:flowNodeRef>gw_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_voucher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ref_m</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_mkt" name="Retoure im Marktplatz-Tool angemeldet">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="s_web" name="Retoure im Webshop-Formular angemeldet">
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:startEvent id="s_mail" name="Retoure formlos per E-Mail angemeldet">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="t_mkt" name="Marktplatz-Portal sichten, Daten abtippen">
      <bpmn:documentation>Eigene API je Marktplatz, keine Anbindung an das ERP (Medienbruch).</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:ioSpecification id="IoSpec_t_mkt">
        <bpmn:dataInput id="Input_DS_mkt" />
        <bpmn:inputSet id="InputSet_t_mkt">
          <bpmn:dataInputRefs>Input_DS_mkt</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_t_mkt" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Assoc_DS_mkt"><bpmn:sourceRef>DS_mkt</bpmn:sourceRef><bpmn:targetRef>Input_DS_mkt</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t_mail" name="E-Mail lesen, Daten nachfragen, abtippen">
      <bpmn:documentation>Unstrukturierte Anmeldung; fehlende Angaben werden per E-Mail nachgefragt.</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_erp" name="Anmeldung im ERP manuell erfassen &amp; prüfen">
      <bpmn:documentation>Mehrfache manuelle Datenpflege; Prüfung nach Erfahrung der Sachbearbeiter:in.</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:ioSpecification id="IoSpec_t_erp">
        <bpmn:dataInput id="Input_DS_web" />
        <bpmn:inputSet id="InputSet_t_erp">
          <bpmn:dataInputRefs>Input_DS_web</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_t_erp" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Assoc_DS_web"><bpmn:sourceRef>DS_web</bpmn:sourceRef><bpmn:targetRef>Input_DS_web</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Assoc_DS_erp1"><bpmn:targetRef>DS_erp1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_ok" name="Anmeldung gültig?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_rej" name="Ablehnung per E-Mail mitteilen">
      <bpmn:documentation>Z. B. abgelaufene Frist oder nicht retournierbarer Artikel; wird von Hand aussortiert.</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_rej" name="Retoure abgelehnt">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_label" name="Retourenlabel manuell im Versandtool erstellen">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_vers"><bpmn:targetRef>DS_vers</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t_send" name="Label per E-Mail an Kund:in senden">
      <bpmn:documentation>Danach schickt die Kund:in die Ware zurück; ShopEasy sieht keinen Sendungsstatus.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_mail1"><bpmn:targetRef>DS_mail1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ev_wait" name="Paket trifft im Lager ein">
      <bpmn:documentation>Kein Status-Tracking zwischen Rückversand und Eintreffen im Lager.</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_gr" name="Wareneingang &amp; Zustandsprüfung im WMS erfassen (oft verzögert)">
      <bpmn:documentation>Zustand: neuwertig / beschädigt / getragen. Subjektiv, Erfassung zeitversetzt.</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_wms"><bpmn:targetRef>DS_wms</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="t_dec" name="Annahme / Ablehnung entscheiden">
      <bpmn:documentation>Entscheidung nicht dokumentiert und nicht regelbasiert.</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw1" name="Ergebnis?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_esc" name="Grenzfall per E-Mail eskalieren &amp; dokumentieren">
      <bpmn:documentation>Dokumentation nur im E-Mail-Postfach.</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_mail2"><bpmn:targetRef>DS_mail2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t_stock" name="Bestand im ERP buchen">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_erp2"><bpmn:targetRef>DS_erp2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:manualTask id="t_reject" name="Rückversand / Entsorgung / Spende veranlassen">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_ref" name="Erstattungsart?">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_pay" name="Rückerstattung manuell veranlassen">
      <bpmn:documentation>Manuelle Buchung; größter Anteil an der Durchlaufzeit von 8–12 Tagen.</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_zdl"><bpmn:targetRef>DS_zdl</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t_voucher" name="Gutschein manuell im CRM eintragen">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_crm"><bpmn:targetRef>DS_crm</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_ref_m">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_m">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_comm" name="Kund:in per E-Mail informieren (verzögert)">
      <bpmn:documentation>Häufige Nachfragen der Kund:innen.</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_mail3"><bpmn:targetRef>DS_mail3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Retoure abgeschlossen">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_rep" name="Monatsende">
      <bpmn:outgoing>f28</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="t_report" name="Monatliches Reporting in Excel erstellen">
      <bpmn:documentation>Retourenquote, Bearbeitungsdauer, Gründe – manuell aus E-Mails und Listen zusammengestellt.</bpmn:documentation>
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_DS_xls"><bpmn:targetRef>DS_xls</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="end_rep" name="Report erstellt">
      <bpmn:incoming>f29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_web" name="Webshop-Frontend" />
    <bpmn:dataStoreReference id="DS_mkt" name="Marktplatz-Portale" />
    <bpmn:dataStoreReference id="DS_erp1" name="ERP-System" />
    <bpmn:dataStoreReference id="DS_vers" name="Versandtool" />
    <bpmn:dataStoreReference id="DS_mail1" name="E-Mail-Postfach" />
    <bpmn:dataStoreReference id="DS_wms" name="WMS" />
    <bpmn:dataStoreReference id="DS_mail2" name="E-Mail-Postfach" />
    <bpmn:dataStoreReference id="DS_erp2" name="ERP-System" />
    <bpmn:dataStoreReference id="DS_zdl" name="Zahlungsdienstleister" />
    <bpmn:dataStoreReference id="DS_crm" name="CRM" />
    <bpmn:dataStoreReference id="DS_mail3" name="E-Mail-Postfach" />
    <bpmn:dataStoreReference id="DS_xls" name="Excel-Listen" />
    <bpmn:sequenceFlow id="f1" sourceRef="s_mkt" targetRef="t_mkt" />
    <bpmn:sequenceFlow id="f2" sourceRef="s_web" targetRef="t_erp" />
    <bpmn:sequenceFlow id="f3" sourceRef="s_mail" targetRef="t_mail" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_mkt" targetRef="t_erp" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_mail" targetRef="t_erp" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_erp" targetRef="gw_ok" />
    <bpmn:sequenceFlow id="f7" name="ja" sourceRef="gw_ok" targetRef="t_label" />
    <bpmn:sequenceFlow id="f8" name="nein" sourceRef="gw_ok" targetRef="t_rej" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_rej" targetRef="end_rej" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_label" targetRef="t_send" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_send" targetRef="ev_wait" />
    <bpmn:sequenceFlow id="f12" sourceRef="ev_wait" targetRef="t_gr" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_gr" targetRef="t_dec" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_dec" targetRef="gw1" />
    <bpmn:sequenceFlow id="f15" name="Annahme" sourceRef="gw1" targetRef="t_stock" />
    <bpmn:sequenceFlow id="f16" name="Ablehnung" sourceRef="gw1" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f17" name="Grenzfall" sourceRef="gw1" targetRef="t_esc" />
    <bpmn:sequenceFlow id="f18" name="erneut entscheiden" sourceRef="t_esc" targetRef="t_dec" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_stock" targetRef="gw_ref" />
    <bpmn:sequenceFlow id="f20" name="Geld zurück" sourceRef="gw_ref" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f21" name="Gutschein" sourceRef="gw_ref" targetRef="t_voucher" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_pay" targetRef="gw_ref_m" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_voucher" targetRef="gw_ref_m" />
    <bpmn:sequenceFlow id="f24" sourceRef="gw_ref_m" targetRef="gw_m" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_reject" targetRef="gw_m" />
    <bpmn:sequenceFlow id="f26" sourceRef="gw_m" targetRef="t_comm" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_comm" targetRef="end" />
    <bpmn:sequenceFlow id="f28" sourceRef="s_rep" targetRef="t_report" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_report" targetRef="end_rep" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Ist">
    <bpmndi:BPMNPlane id="Plane_Ist" bpmnElement="Collab_Ist">
      <bpmndi:BPMNShape id="Participant_Ist_di" bpmnElement="Participant_Ist" isHorizontal="true">
        <dc:Bounds x="0" y="140" width="2900" height="1270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ext_Markt_di" bpmnElement="Ext_Markt" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="260" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ext_Kunde_di" bpmnElement="Ext_Kunde" isHorizontal="true">
        <dc:Bounds x="300" y="0" width="2600" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true">
        <dc:Bounds x="30" y="140" width="2870" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lager_di" bpmnElement="Lane_Lager" isHorizontal="true">
        <dc:Bounds x="30" y="800" width="2870" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Buch_di" bpmnElement="Lane_Buch" isHorizontal="true">
        <dc:Bounds x="30" y="1030" width="2870" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_mkt_di" bpmnElement="s_mkt">
        <dc:Bounds x="172" y="167" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="214" y="162" width="96" height="46" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_web_di" bpmnElement="s_web">
        <dc:Bounds x="312" y="167" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="354" y="162" width="96" height="46" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_mail_di" bpmnElement="s_mail">
        <dc:Bounds x="452" y="167" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="494" y="162" width="100" height="46" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_mkt_di" bpmnElement="t_mkt">
        <dc:Bounds x="135" y="300" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_mail_di" bpmnElement="t_mail">
        <dc:Bounds x="415" y="300" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_erp_di" bpmnElement="t_erp">
        <dc:Bounds x="585" y="400" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ok_di" bpmnElement="gw_ok" isMarkerVisible="true">
        <dc:Bounds x="765" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rej_di" bpmnElement="t_rej">
        <dc:Bounds x="895" y="280" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rej_di" bpmnElement="end_rej">
        <dc:Bounds x="1062" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_label_di" bpmnElement="t_label">
        <dc:Bounds x="895" y="400" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_send_di" bpmnElement="t_send">
        <dc:Bounds x="1085" y="400" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_wait_di" bpmnElement="ev_wait">
        <dc:Bounds x="1272" y="862" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_gr_di" bpmnElement="t_gr">
        <dc:Bounds x="1385" y="840" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_dec_di" bpmnElement="t_dec">
        <dc:Bounds x="1545" y="400" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1" isMarkerVisible="true">
        <dc:Bounds x="1725" y="415" width="50" height="50" />
